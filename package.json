{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vite preview",
    "server:dev": "node scripts/riftbound-local.mjs server",
    "db:up": "node scripts/riftbound-local.mjs up",
    "db:stop": "node scripts/riftbound-local.mjs stop",
    "db:check": "node scripts/riftbound-local.mjs check",
    "catalog:import": "node scripts/riftbound-import.mjs",
    "catalog:snapshot": "node scripts/riftbound-catalog-snapshot.mjs",
    "ownership:import": "node scripts/riftbound-ownership-import.mjs",
    "catalog:check": "node scripts/riftcodex-check.mjs",
    "prices:sync": "node scripts/riftbound-prices.mjs",
    "server:check": "wrangler deploy --config wrangler.site.jsonc --dry-run --outdir .wrangler/site-check",
    "db:migrate": "node scripts/riftbound-migrate.mjs",
    "durations": "node scripts/fetch-durations.mjs",
    "snapshot:github": "node scripts/snapshot-github.mjs",
    "proxy:dev": "npm --prefix proxy run dev",
    "proxy:deploy": "npm --prefix proxy run deploy",
    "deploy:site": "npm run build && npx wrangler deploy --config wrangler.site.jsonc"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "fflate": "^0.8.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  }
}
